{
  "name": "unconf",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "test:unit": "vitest",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:security": "eslint . --config .eslintrc.security.js || echo 'Security ESLint config not found'",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "demo:create": "node create-demo-data.mjs",
    "demo:init": "node init-demo-data.mjs",
    "demo:update": "node demo-features.mjs",
    "demo:specs": "node update-task-specs.mjs show",
    "demo:voting": "node demo-features.mjs votingSystem",
    "demo:games": "node demo-features.mjs groupIntelligence",
    "demo:rooms": "node demo-features.mjs discussionGroups",
    "demo:teams": "node demo-features.mjs teamDistribution",
    "demo:analytics": "node demo-features.mjs analytics",
    "test:load": "node load-tests/run-load-tests.js",
    "test:load:websocket": "npx artillery run load-tests/artillery-config.yml",
    "test:load:http": "npx artillery run load-tests/http-load-test.yml",
    "test:coverage": "npm run test:unit -- --coverage",
    "test:coverage:validate": "node scripts/validate-coverage.js",
    "test:coverage:full": "npm run test:coverage && npm run test:coverage:validate",
    "test:security": "node --loader ts-node/esm src/lib/security/security-audit.ts",
    "test:security:manual": "node scripts/security-test.mjs",
    "test:security:full": "npm run test:security && npm run test:security:manual",
    "security:audit": "npm audit --audit-level=moderate",
    "security:check": "npm run security:audit && npm run lint",
    "pre-commit": "bash scripts/pre-commit-ci.sh",
    "pre-commit:quick": "bash scripts/pre-commit-ci.sh"
  },
  "devDependencies": {
    "@sveltejs/adapter-auto": "^6.0.0",
    "@sveltejs/adapter-vercel": "^5.10.2",
    "@sveltejs/kit": "^2.49.5",
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/svelte": "^5.2.8",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^24.5.2",
    "@typescript-eslint/eslint-plugin": "^8.44.1",
    "@typescript-eslint/parser": "^8.44.1",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "artillery": "^2.0.27",
    "axe-core": "^4.10.3",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.12.4",
    "globals": "^16.4.0",
    "jsdom": "^27.0.0",
    "prettier": "^3.6.2",
    "prettier-plugin-svelte": "^3.4.0",
    "rollup-plugin-visualizer": "^6.0.4",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "terser": "^5.44.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.44.1",
    "vite": "^7.1.11",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@auth/core": "^0.40.0",
    "@auth/sveltekit": "^1.10.0",
    "@growthbook/growthbook": "^1.6.2",
    "@types/dompurify": "^3.0.5",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/qrcode": "^1.5.5",
    "@types/socket.io": "^3.0.1",
    "@vercel/analytics": "^1.6.1",
    "@vercel/blob": "^2.0.1",
    "@vercel/speed-insights": "^1.3.1",
    "bcryptjs": "^3.0.2",
    "dompurify": "^3.2.7",
    "jsonwebtoken": "^9.0.2",
    "lucide-svelte": "^0.544.0",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "svelte-i18n": "^4.0.1",
    "zod": "^4.1.11"
  }
}
