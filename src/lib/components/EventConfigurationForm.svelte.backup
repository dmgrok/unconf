<!--
  Event Configuration Form Component
  Multi-step wizard with real-time validation and guided experience
-->
<script lang="ts">
  import { createEventDispatcher } from 'svelte';
  import { writable } from 'svelte/store';
  import type { Event } from '../../types/entities';
  import FormInput from './ui/FormInput.svelte';
  import FormTextarea from './ui/FormTextarea.svelte';
  import Button from './ui/Button.svelte';
  import ProgressSteps from './ui/ProgressSteps.svelte';

  interface EventConfigurationFormProps {
    eventId?: string | null;
    initialData?: Partial<Event> | null;
    organizerId: string;
    organizerName?: string;
    mode?: 'create' | 'edit';
  }

  let {
    eventId = null,
    initialData = null,
    organizerId,
    organizerName = '',
    mode = 'create'
  }: EventConfigurationFormProps = $props();

  // Wizard steps
  const steps = [
    { label: 'Basic Info', icon: '📝' },
    { label: 'Settings', icon: '⚙️' },
    { label: 'Voting Rules', icon: '🗳️' }
  ];

  let currentStep = $state(0);

  const dispatch = createEventDispatcher();

  const MAX_TITLE_LENGTH = 200;
  const MAX_DESCRIPTION_LENGTH = 2000;
  const MIN_CAPACITY = 5;
  const MAX_CAPACITY = 1000;
  const MAX_DURATION_DAYS = 7;
  const MIN_DURATION_DAYS = 1;
  const MAX_VOTING_ROUNDS = 10;
  const MAX_TOPICS_PER_USER = 20;
  const MAX_VOTING_TIME_MINUTES = 60;
  const MIN_VOTING_TIME_MINUTES = 1;

  const DEFAULT_DURATION_DAYS = 3;
  const DEFAULT_CAPACITY = 20;
  const DEFAULT_VOTING_ROUNDS = 1;
  const DEFAULT_MAX_TOPICS_PER_USER = 3;
  const DEFAULT_VOTING_TIME_MINUTES = 5;

  let title = initialData?.title ?? '';
  let description = initialData?.description ?? '';
  let capacity = initialData?.maxParticipants ?? DEFAULT_CAPACITY;
  let duration = DEFAULT_DURATION_DAYS;
  let isPrivate = initialData?.settings?.allowGuestAccess === false;
  let allowGuestAccess = initialData?.settings?.allowGuestAccess ?? true;
  let votingRounds = DEFAULT_VOTING_ROUNDS;
  let maxTopicsPerUser = initialData?.settings?.maxTopicsPerUser ?? DEFAULT_MAX_TOPICS_PER_USER;
  let votingTimeLimit = initialData?.settings?.votingTimeLimit
    ? Math.max(MIN_VOTING_TIME_MINUTES, Math.round(initialData.settings.votingTimeLimit / 60))
    : DEFAULT_VOTING_TIME_MINUTES;
  let isSubmitting = false;

  let lastInitialSyncKey: string | null = null;

  type FieldValidationState = { isValid: boolean; message: string };
  type ValidationState = {
    title: FieldValidationState;
    description: FieldValidationState;
    capacity: FieldValidationState;
    duration: FieldValidationState;
    votingRounds: FieldValidationState;
    maxTopicsPerUser: FieldValidationState;
    votingTimeLimit: FieldValidationState;
    form: { isValid: boolean; canSubmit: boolean };
  };

  const initialValidationState: ValidationState = {
    title: { isValid: true, message: '' },
    description: { isValid: true, message: '' },
    capacity: { isValid: true, message: '' },
    duration: { isValid: true, message: '' },
    votingRounds: { isValid: true, message: '' },
    maxTopicsPerUser: { isValid: true, message: '' },
    votingTimeLimit: { isValid: true, message: '' },
    form: { isValid: true, canSubmit: false }
  };

  const validation = writable<ValidationState>(initialValidationState);

  function updateValidationField<K extends keyof ValidationState>(
    key: K,
    value: ValidationState[K]
  ) {
    validation.update(current => ({
      ...current,
      [key]: value
    }));
  }

  $: {
    if (mode === 'edit' && initialData) {
      const syncKey = getInitialSyncKey(initialData);
      if (syncKey && syncKey !== lastInitialSyncKey) {
        hydrateFromInitialData(initialData);
        lastInitialSyncKey = syncKey;
      }
    } else if (mode === 'create' && lastInitialSyncKey !== 'create') {
      resetForm();
      lastInitialSyncKey = 'create';
    }
  }

  $: if (isPrivate && allowGuestAccess) {
    allowGuestAccess = false;
  }

  $: validateTitle(title);
  $: validateDescription(description);
  $: validateCapacity(capacity);
  $: validateDuration(duration);
  $: validateVotingRounds(votingRounds);
  $: validateMaxTopicsPerUser(maxTopicsPerUser);
  $: validateVotingTimeLimit(votingTimeLimit);
  $: updateFormValidation(
    title,
    description,
    capacity,
    duration,
    votingRounds,
    maxTopicsPerUser,
    votingTimeLimit
  );

  function getInitialSyncKey(data: Partial<Event> | null | undefined): string | null {
    if (!data) return null;
    if (typeof data.id === 'string' && data.id.length > 0) {
      return data.id;
    }
    if (data.updatedAt instanceof Date) {
      return `updated:${data.updatedAt.toISOString()}`;
    }
    if (typeof data.updatedAt === 'string' && data.updatedAt.length > 0) {
      return `updated:${data.updatedAt}`;
    }
    return JSON.stringify({
      title: data.title ?? '',
      maxParticipants: data.maxParticipants ?? null
    });
  }

  function hydrateFromInitialData(data: Partial<Event>) {
    const resolvedCapacity = Number(data.maxParticipants ?? DEFAULT_CAPACITY);
    capacity = Math.min(
      MAX_CAPACITY,
      Math.max(MIN_CAPACITY, Number.isFinite(resolvedCapacity) ? resolvedCapacity : DEFAULT_CAPACITY)
    );

    title = data.title ?? '';
    description = data.description ?? '';

    if (data.startTime && data.endTime) {
      const start = new Date(data.startTime as unknown as string);
      const end = new Date(data.endTime as unknown as string);
      if (!Number.isNaN(start.getTime()) && !Number.isNaN(end.getTime()) && end.getTime() > start.getTime()) {
        const diffInDays = (end.getTime() - start.getTime()) / (24 * 60 * 60 * 1000);
        duration = Math.min(
          MAX_DURATION_DAYS,
          Math.max(MIN_DURATION_DAYS, Number(diffInDays.toFixed(2)))
        );
      } else {
        duration = DEFAULT_DURATION_DAYS;
      }
    } else {
      duration = DEFAULT_DURATION_DAYS;
    }

    isPrivate = data.settings?.allowGuestAccess === false;
    allowGuestAccess = data.settings?.allowGuestAccess ?? true;

    const resolvedMaxTopics = Number(data.settings?.maxTopicsPerUser ?? DEFAULT_MAX_TOPICS_PER_USER);
    maxTopicsPerUser = Math.min(
      MAX_TOPICS_PER_USER,
      Math.max(1, Number.isFinite(resolvedMaxTopics) ? Math.round(resolvedMaxTopics) : DEFAULT_MAX_TOPICS_PER_USER)
    );

    const existingVotingTime = Number(data.settings?.votingTimeLimit ?? DEFAULT_VOTING_TIME_MINUTES * 60);
    votingTimeLimit = Math.min(
      MAX_VOTING_TIME_MINUTES,
      Math.max(
        MIN_VOTING_TIME_MINUTES,
        Number.isFinite(existingVotingTime) ? Math.round(existingVotingTime / 60) : DEFAULT_VOTING_TIME_MINUTES
      )
    );

    const { votingRounds: metadataRounds } = (data.metadata ?? {}) as { votingRounds?: unknown };
    votingRounds = Math.min(
      MAX_VOTING_ROUNDS,
      Math.max(
        1,
        typeof metadataRounds === 'number'
          ? Math.round(metadataRounds)
          : DEFAULT_VOTING_ROUNDS
      )
    );

    if (isPrivate) {
      allowGuestAccess = false;
    }
  }

  function validateTitle(value: string) {
    if (!value.trim()) {
      updateValidationField('title', { isValid: false, message: 'Event title is required' });
    } else if (value.length < 3) {
      updateValidationField('title', { isValid: false, message: 'Title must be at least 3 characters' });
    } else if (value.length > MAX_TITLE_LENGTH) {
      updateValidationField('title', {
        isValid: false,
        message: `Title must not exceed ${MAX_TITLE_LENGTH} characters`
      });
    } else {
      updateValidationField('title', { isValid: true, message: '' });
    }
  }

  function validateDescription(value: string) {
    if (value.length > MAX_DESCRIPTION_LENGTH) {
      updateValidationField('description', {
        isValid: false,
        message: `Description must not exceed ${MAX_DESCRIPTION_LENGTH} characters`
      });
    } else {
      updateValidationField('description', { isValid: true, message: '' });
    }
  }

  function validateCapacity(value: number | string) {
    const numericValue = Number(value);
    if (!Number.isFinite(numericValue)) {
      updateValidationField('capacity', { isValid: false, message: 'Capacity must be a number' });
    } else if (numericValue < MIN_CAPACITY) {
      updateValidationField('capacity', {
        isValid: false,
        message: `Minimum capacity is ${MIN_CAPACITY} participants`
      });
    } else if (numericValue > MAX_CAPACITY) {
      updateValidationField('capacity', {
        isValid: false,
        message: `Maximum capacity is ${MAX_CAPACITY} participants`
      });
    } else {
      updateValidationField('capacity', { isValid: true, message: '' });
    }
  }

  function validateDuration(value: number | string) {
    const numericValue = Number(value);
    if (!Number.isFinite(numericValue)) {
      updateValidationField('duration', { isValid: false, message: 'Duration must be a number' });
    } else if (numericValue < MIN_DURATION_DAYS) {
      updateValidationField('duration', {
        isValid: false,
        message: `Minimum duration is ${MIN_DURATION_DAYS} day`
      });
    } else if (numericValue > MAX_DURATION_DAYS) {
      updateValidationField('duration', {
        isValid: false,
        message: `Maximum duration is ${MAX_DURATION_DAYS} days`
      });
    } else {
      updateValidationField('duration', { isValid: true, message: '' });
    }
  }

  function validateVotingRounds(value: number | string) {
    const numericValue = Number(value);
    if (!Number.isFinite(numericValue)) {
      updateValidationField('votingRounds', { isValid: false, message: 'Voting rounds must be a number' });
    } else if (numericValue < 1) {
      updateValidationField('votingRounds', {
        isValid: false,
        message: 'At least 1 voting round is required'
      });
    } else if (numericValue > MAX_VOTING_ROUNDS) {
      updateValidationField('votingRounds', {
        isValid: false,
        message: `Maximum ${MAX_VOTING_ROUNDS} voting rounds allowed`
      });
    } else {
      updateValidationField('votingRounds', { isValid: true, message: '' });
    }
  }

  function validateMaxTopicsPerUser(value: number | string) {
    const numericValue = Number(value);
    if (!Number.isFinite(numericValue)) {
      updateValidationField('maxTopicsPerUser', { isValid: false, message: 'Max topics must be a number' });
    } else if (numericValue < 1) {
      updateValidationField('maxTopicsPerUser', {
        isValid: false,
        message: 'At least 1 topic per user is required'
      });
    } else if (numericValue > MAX_TOPICS_PER_USER) {
      updateValidationField('maxTopicsPerUser', {
        isValid: false,
        message: `Maximum ${MAX_TOPICS_PER_USER} topics per user allowed`
      });
    } else {
      updateValidationField('maxTopicsPerUser', { isValid: true, message: '' });
    }
  }

  function validateVotingTimeLimit(value: number | string) {
    const numericValue = Number(value);
    if (!Number.isFinite(numericValue)) {
      updateValidationField('votingTimeLimit', { isValid: false, message: 'Voting time must be a number' });
    } else if (numericValue < MIN_VOTING_TIME_MINUTES) {
      updateValidationField('votingTimeLimit', {
        isValid: false,
        message: `Minimum voting time is ${MIN_VOTING_TIME_MINUTES} minute`
      });
    } else if (numericValue > MAX_VOTING_TIME_MINUTES) {
      updateValidationField('votingTimeLimit', {
        isValid: false,
        message: `Maximum voting time is ${MAX_VOTING_TIME_MINUTES} minutes`
      });
    } else {
      updateValidationField('votingTimeLimit', { isValid: true, message: '' });
    }
  }

  function updateFormValidation(..._deps: unknown[]) {
    validation.update(v => {
      const trimmedTitle = title.trim();
      const isFormValid =
        v.title.isValid &&
        v.description.isValid &&
        v.capacity.isValid &&
        v.duration.isValid &&
        v.votingRounds.isValid &&
        v.maxTopicsPerUser.isValid &&
        v.votingTimeLimit.isValid;

      const canSubmit = isFormValid && trimmedTitle.length >= 3;
      return {
        ...v,
        form: { isValid: isFormValid, canSubmit }
      };
    });
  }

  async function handleSubmit() {
    if (!$validation.form.canSubmit || isSubmitting) return;

    isSubmitting = true;

    const trimmedTitle = title.trim();
    const trimmedDescription = description.trim();

    const normalizedCapacity = Number(capacity);
    const normalizedDuration = Number(duration);
    const normalizedVotingRounds = Number(votingRounds);
    const normalizedMaxTopicsPerUser = Number(maxTopicsPerUser);
    const normalizedVotingTimeLimit = Number(votingTimeLimit);

    const safeCapacity = Number.isFinite(normalizedCapacity) ? Math.round(normalizedCapacity) : DEFAULT_CAPACITY;
    const clampedCapacity = Math.min(MAX_CAPACITY, Math.max(MIN_CAPACITY, safeCapacity));

    const safeDuration = Number.isFinite(normalizedDuration) ? normalizedDuration : DEFAULT_DURATION_DAYS;
    const clampedDurationDays = Math.min(
      MAX_DURATION_DAYS,
      Math.max(MIN_DURATION_DAYS, safeDuration)
    );

    const safeVotingRounds = Number.isFinite(normalizedVotingRounds)
      ? Math.round(normalizedVotingRounds)
      : DEFAULT_VOTING_ROUNDS;
    const clampedVotingRounds = Math.min(
      MAX_VOTING_ROUNDS,
      Math.max(1, safeVotingRounds)
    );

    const safeMaxTopicsPerUser = Number.isFinite(normalizedMaxTopicsPerUser)
      ? Math.round(normalizedMaxTopicsPerUser)
      : DEFAULT_MAX_TOPICS_PER_USER;
    const clampedMaxTopicsPerUser = Math.min(
      MAX_TOPICS_PER_USER,
      Math.max(1, safeMaxTopicsPerUser)
    );

    const safeVotingTimeLimit = Number.isFinite(normalizedVotingTimeLimit)
      ? Math.round(normalizedVotingTimeLimit)
      : DEFAULT_VOTING_TIME_MINUTES;
    const clampedVotingMinutes = Math.min(
      MAX_VOTING_TIME_MINUTES,
      Math.max(MIN_VOTING_TIME_MINUTES, safeVotingTimeLimit)
    );

    const baseSettings = {
      allowGuestAccess: !isPrivate && !!allowGuestAccess,
      maxTopicsPerUser: clampedMaxTopicsPerUser,
      votingTimeLimit: clampedVotingMinutes * 60
    };

    let url = '';
    let method: 'POST' | 'PUT' = 'POST';
    let payload: Record<string, unknown> = {};

    if (mode === 'create') {
      url = '/api/events';
      method = 'POST';
      payload = {
        title: trimmedTitle,
        description: trimmedDescription,
        duration: clampedDurationDays * 24 * 60 * 60 * 1000,
        capacity: clampedCapacity,
        organizerId,
        organizerName,
        settings: {
          ...baseSettings,
          votingRounds: clampedVotingRounds
        }
      };
    } else {
      url = `/api/events/${eventId}`;
      method = 'PUT';
      payload = {
        title: trimmedTitle,
        description: trimmedDescription,
        maxParticipants: clampedCapacity,
        settings: {
          allowGuestAccess: baseSettings.allowGuestAccess,
          maxTopicsPerUser: baseSettings.maxTopicsPerUser,
          votingTimeLimit: baseSettings.votingTimeLimit
        }
      };
    }

    try {
      const response = await fetch(url, {
        method,
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify(payload)
      });

      const result = await response.json();

      if (result.success) {
        dispatch('eventSaved', { event: result.event, mode });

        if (mode === 'create') {
          resetForm();
          lastInitialSyncKey = 'create';
        }
      } else {
        dispatch('error', {
          message: result.error || `Failed to ${mode} event. Please try again.`,
          details: result.details
        });
      }
    } catch (error) {
      console.error(`Event ${mode} error:`, error);
      dispatch('error', { message: 'Network error. Please try again.' });
    } finally {
      isSubmitting = false;
    }
  }

  function resetForm() {
    title = '';
    description = '';
    capacity = DEFAULT_CAPACITY;
    duration = DEFAULT_DURATION_DAYS;
    isPrivate = false;
    allowGuestAccess = true;
    votingRounds = DEFAULT_VOTING_ROUNDS;
    maxTopicsPerUser = DEFAULT_MAX_TOPICS_PER_USER;
    votingTimeLimit = DEFAULT_VOTING_TIME_MINUTES;
  }

  function handleCancel() {
    dispatch('cancel');
  }
</script>

<form on:submit|preventDefault={handleSubmit} class="event-form">
  <div class="form-header">
    <h2>{mode === 'create' ? 'Create New Event' : 'Edit Event'}</h2>
    <p class="form-subtitle">Configure your unconference event settings and constraints</p>
  </div>

  <!-- Basic Information -->
  <section class="form-section">
    <h3>Basic Information</h3>

    <div class="form-group">
      <label for="event-title" class="form-label">
        Event Title *
        <span class="char-count" class:warning={title.length > MAX_TITLE_LENGTH * 0.8}>
          {title.length}/{MAX_TITLE_LENGTH}
        </span>
      </label>
      <input
        id="event-title"
        type="text"
        bind:value={title}
        maxlength={MAX_TITLE_LENGTH}
        placeholder="Enter a descriptive title for your event"
        class="form-input"
        class:invalid={!$validation.title.isValid}
        disabled={isSubmitting}
        required
      />
      {#if !$validation.title.isValid}
        <div class="error-message">{$validation.title.message}</div>
      {/if}
    </div>

    <div class="form-group">
      <label for="event-description" class="form-label">
        Description
        <span class="char-count" class:warning={description.length > MAX_DESCRIPTION_LENGTH * 0.8}>
          {description.length}/{MAX_DESCRIPTION_LENGTH}
        </span>
      </label>
      <textarea
        id="event-description"
        bind:value={description}
        maxlength={MAX_DESCRIPTION_LENGTH}
        placeholder="Provide details about your event, its goals, and what participants can expect"
        rows="4"
        class="form-textarea"
        class:invalid={!$validation.description.isValid}
        disabled={isSubmitting}
      ></textarea>
      {#if !$validation.description.isValid}
        <div class="error-message">{$validation.description.message}</div>
      {/if}
    </div>
  </section>

  <!-- Event Constraints -->
  <section class="form-section">
    <h3>Event Constraints</h3>

    <div class="form-row">
      <div class="form-group">
        <label for="event-capacity" class="form-label">
          Maximum Participants *
          <span class="constraint-note">Min: {MIN_CAPACITY}, Max: {MAX_CAPACITY}</span>
        </label>
        <input
          id="event-capacity"
          type="number"
          bind:value={capacity}
          min={MIN_CAPACITY}
          max={MAX_CAPACITY}
          class="form-input"
          class:invalid={!$validation.capacity.isValid}
          disabled={isSubmitting}
          required
        />
        {#if !$validation.capacity.isValid}
          <div class="error-message">{$validation.capacity.message}</div>
        {/if}
      </div>

      <div class="form-group">
        <label for="event-duration" class="form-label">
          Duration (days) *
          <span class="constraint-note">Max: {MAX_DURATION_DAYS} days</span>
        </label>
        <input
          id="event-duration"
          type="number"
          bind:value={duration}
          min={MIN_DURATION_DAYS}
          max={MAX_DURATION_DAYS}
          step="0.5"
          class="form-input"
          class:invalid={!$validation.duration.isValid}
          disabled={isSubmitting}
          required
        />
        {#if !$validation.duration.isValid}
          <div class="error-message">{$validation.duration.message}</div>
        {/if}
      </div>
    </div>
  </section>

  <!-- Access & Privacy -->
  <section class="form-section">
    <h3>Access & Privacy</h3>

    <div class="form-group">
      <label class="checkbox-container">
        <input
          type="checkbox"
          bind:checked={isPrivate}
          disabled={isSubmitting}
        />
        <span class="checkmark"></span>
        <div class="checkbox-content">
          <span class="checkbox-label">Private Event</span>
          <span class="checkbox-description">Only invited participants can join</span>
        </div>
      </label>
    </div>

    {#if !isPrivate}
      <div class="form-group">
        <label class="checkbox-container">
          <input
            type="checkbox"
            bind:checked={allowGuestAccess}
            disabled={isSubmitting}
          />
          <span class="checkmark"></span>
          <div class="checkbox-content">
            <span class="checkbox-label">Allow Guest Access</span>
            <span class="checkbox-description">Participants can join without creating an account</span>
          </div>
        </label>
      </div>
    {/if}
  </section>

  <!-- Voting Configuration -->
  <section class="form-section">
    <h3>Voting Configuration</h3>

    <div class="form-row">
      <div class="form-group">
        <label for="voting-rounds" class="form-label">
          Voting Rounds
          <span class="constraint-note">Max: {MAX_VOTING_ROUNDS}</span>
        </label>
        <input
          id="voting-rounds"
          type="number"
          bind:value={votingRounds}
          min="1"
          max={MAX_VOTING_ROUNDS}
          class="form-input"
          class:invalid={!$validation.votingRounds.isValid}
          disabled={isSubmitting}
        />
        {#if !$validation.votingRounds.isValid}
          <div class="error-message">{$validation.votingRounds.message}</div>
        {/if}
      </div>

      <div class="form-group">
        <label for="voting-time-limit" class="form-label">
          Voting Time Limit (minutes)
          <span class="constraint-note">Max: {MAX_VOTING_TIME_MINUTES} min</span>
        </label>
        <input
          id="voting-time-limit"
          type="number"
          bind:value={votingTimeLimit}
          min={MIN_VOTING_TIME_MINUTES}
          max={MAX_VOTING_TIME_MINUTES}
          class="form-input"
          class:invalid={!$validation.votingTimeLimit.isValid}
          disabled={isSubmitting}
        />
        {#if !$validation.votingTimeLimit.isValid}
          <div class="error-message">{$validation.votingTimeLimit.message}</div>
        {/if}
      </div>
    </div>

    <div class="form-group">
      <label for="max-topics-per-user" class="form-label">
        Max Topics per User
        <span class="constraint-note">Max: {MAX_TOPICS_PER_USER}</span>
      </label>
      <input
        id="max-topics-per-user"
        type="number"
        bind:value={maxTopicsPerUser}
        min="1"
        max={MAX_TOPICS_PER_USER}
        class="form-input"
        class:invalid={!$validation.maxTopicsPerUser.isValid}
        disabled={isSubmitting}
      />
      {#if !$validation.maxTopicsPerUser.isValid}
        <div class="error-message">{$validation.maxTopicsPerUser.message}</div>
      {/if}
    </div>
  </section>

  <!-- Form Actions -->
  <div class="form-actions">
    <button
      type="button"
      on:click={handleCancel}
      class="btn btn-secondary"
      disabled={isSubmitting}
    >
      Cancel
    </button>

    {#if mode === 'create'}
      <button
        type="button"
        on:click={resetForm}
        class="btn btn-secondary"
        disabled={isSubmitting}
      >
        Reset
      </button>
    {/if}

    <button
      type="submit"
      class="btn btn-primary"
      disabled={!$validation.form.canSubmit || isSubmitting}
    >
      {#if isSubmitting}
        {mode === 'create' ? 'Creating...' : 'Saving...'}
      {:else}
        {mode === 'create' ? 'Create Event' : 'Save Changes'}
      {/if}
    </button>
  </div>

  <div class="form-footer">
    <small class="help-text">
      * Required fields. {mode === 'create' ? 'Events start as drafts and can be activated later.' : 'Changes will be applied immediately.'}
    </small>
  </div>
</form>

<style>
  .event-form {
    max-width: 800px;
    margin: 0 auto;
    padding: 2rem;
    background: var(--surface-color, #ffffff);
    border-radius: 12px;
    border: 1px solid var(--border-color, #e0e0e0);
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);
  }

  .form-header {
    margin-bottom: 2rem;
    text-align: center;
  }

  .form-header h2 {
    margin: 0 0 0.5rem 0;
    color: var(--text-primary, #1f2937);
    font-size: 1.75rem;
    font-weight: 600;
  }

  .form-subtitle {
    color: var(--text-secondary, #6b7280);
    font-size: 1rem;
    margin: 0;
  }

  .form-section {
    margin-bottom: 2.5rem;
    padding: 1.5rem;
    border: 1px solid var(--border-light, #f3f4f6);
